WATSON_STT_APIKEY=
WATSON_STT_URL=
# Optional — defaults to en-US_Multimedia, falls back to en-US_BroadbandModel
WATSON_STT_MODEL=

ANTHROPIC_API_KEY=
# Optional — overrides the API host, e.g. an internal proxy that mirrors the
# Anthropic Messages API shape. Defaults to https://api.anthropic.com.
ANTHROPIC_BASE_URL=

# Voice output — Watson TTS. Optional; falls back to macOS `say` if unset.
WATSON_TTS_APIKEY=
WATSON_TTS_URL=
# Optional — defaults to en-US_MichaelExpressive, falls back to en-US_MichaelV3Voice
WATSON_TTS_VOICE=
